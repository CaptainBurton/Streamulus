<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Optional: a server address built into the app, so it connects without
	     asking (e.g. your public Tailscale Funnel address for friends' phones).
	     Leave empty to have the app ask on first launch. -->
	<key>StreamulusServerURL</key>
	<string></string>

	<!-- Streamulus is usually reached over plain http:// on your home network. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Streamulus connects to your media server on your local network.</string>
	<!-- Approve a Sign-In: scan the QR code an Apple TV or browser shows. -->
	<key>NSCameraUsageDescription</key>
	<string>Streamulus uses the camera to scan the sign-in QR code shown on your TV or in a browser.</string>

	<!-- Keeps playing in Picture in Picture and over AirPlay when you leave the app. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad: every orientation, so it works in Split View and Stage Manager. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
